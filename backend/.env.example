# Copy to backend/.env if you load it yourself (node --env-file=.env server.js). Never commit .env.
# In AWS these come from Lambda environment settings / Secrets Manager.

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=careerlink
DB_CONNECTION_LIMIT=2

# JWT claim that carries the AD group, and the group values (real values: ask the teammate).
AD_GROUPS_CLAIM=custom:ad_role
AD_STUDENT_GROUP=student
AD_INSTRUCTOR_GROUP=instructor
DISPLAY_NAME_CLAIM=name
