# ローカルでは backend/.env にコピーし、node --env-file=.env server.js で読み込む。.env はコミットしない。
# AWS では Secrets Manager または Lambda の環境設定から値を渡す。

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=careerlink
DB_CONNECTION_LIMIT=2

# RDS接続時は、実行環境に配置したRDS CA証明書のパスを指定する。
# ローカルのMariaDBでTLSを使用しない場合は空欄にする。
DB_SSL_CA_FILE=

# AD グループを格納する JWT クレーム名とグループの値。実際の値は担当者に確認する。
AD_GROUPS_CLAIM=custom:ad_role
AD_STUDENT_GROUP=student
AD_INSTRUCTOR_GROUP=instructor
DISPLAY_NAME_CLAIM=name
